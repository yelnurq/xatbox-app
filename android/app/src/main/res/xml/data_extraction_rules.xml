<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (targetSdk 31+). Corporate mail and chat: nothing the app keeps
  on the device may leave it through a Google account backup or a phone-to-
  phone transfer — the local cache holds message text, drafts, attachments,
  the session token and the PIN. A new device signs in from scratch.
  Older releases are covered by android:allowBackup="false" in the manifest.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
