<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- APNs: "development" for Debug/sandbox builds; Xcode switches it to
	     "production" when archiving for TestFlight/App Store (docs/IOS.md). -->
	<key>aps-environment</key>
	<string>development</string>
	<!-- Shared with the Notification Service Extension: the push key lives in
	     the keychain access group of this App Group (push_crypto.dart). -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.kz.xatbox.xatboxMobile</string>
	</array>
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)kz.xatbox.xatboxMobile</string>
	</array>
</dict>
</plist>
